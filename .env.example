# Meta Model API: the only setting you need.
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1

# Optional. Leave these empty to run in local mode (data in web/.local-data).
# Set all three to use a Supabase project for the database and storage, as the live site does.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Per-workspace spend cap for uploaded walks, in US dollars per day
DAILY_SPEND_CAP_USD=4
# On a hosted site, all visitors together, per day. Ignored in local mode.
OVERALL_DAILY_CAP_USD=15
